# Base URL of the PHP backend for the portfolio API.
#
# Leave EMPTY to call the API same-origin (recommended). In dev, Vite proxies
# /api, /admin and /uploads to the backend (see BACKEND_URL + vite.config.ts),
# so the admin panel opens at http://localhost:5173/admin and no CORS is needed.
#
# Set this to an absolute URL (e.g. http://localhost:8000) only if you want the
# frontend to call a backend on a different origin directly, without the proxy.
VITE_API_BASE_URL=

# Where Vite forwards /api, /admin and /uploads during `npm run dev`.
BACKEND_URL=http://localhost:8000
