# ── Application ──────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
# Fallback base URL of THIS backend (used on the CLI installer and to supply the
# path prefix for sub-directory installs). At runtime, links are built from the
# host that served the request, so opening the admin via the frontend proxy at
# http://localhost:5173/admin generates http://localhost:5173/... links.
APP_URL=http://localhost:8000
# Where the React site lives — powers the "View site" link in the admin panel.
FRONTEND_URL=http://localhost:5173

# ── Database (MySQL / MariaDB) ───────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inworalanding
DB_USERNAME=root
DB_PASSWORD=

# ── Admin panel ──────────────────────────────────────────────
# Seeded into the `admin_users` table by `php database/seed.php`.
# Changing these here does nothing until you re-run the seeder.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the public API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Uploads ──────────────────────────────────────────────────
UPLOAD_MAX_BYTES=5242880
